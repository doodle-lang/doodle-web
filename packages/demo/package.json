{
  "name": "@doodle-lang/demo",
  "version": "0.0.0",
  "description": "The Doodle web demo: a CodeMirror editor + turtle canvas driven by the wasm engine.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:app": "vite build",
    "dev": "vite",
    "preview": "vite preview --outDir dist/app --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "test:browser": "npm run build:app && playwright test"
  },
  "dependencies": {
    "@doodle-lang/engine": "*",
    "@doodle-lang/turtle": "*",
    "@doodle-lang/lezer-doodle": "*",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0",
    "@codemirror/commands": "^6.5.0",
    "@codemirror/language": "^6.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
